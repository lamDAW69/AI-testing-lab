# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — PLIEGO AI / LICITAIA BACKEND API
# ==============================================================================

# Servidor HTTP
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (DEFENSA EN PROFUNDIDAD Y PRIVILEGIOS MÍNIMOS)
# ------------------------------------------------------------------------------
# DATABASE_URL: Conexión utilizada por la aplicación en tiempo de ejecución.
# Debe apuntar al rol con privilegios mínimos ('app_runtime'), el cual tiene
# Row Level Security (RLS) forzado y no posee permisos DDL (no puede alterar tablas).
DATABASE_URL=postgresql://app_runtime:secreto_runtime_cambiar@127.0.0.1:5432/app_db

# ADMIN_DATABASE_URL: Conexión administrativa utilizada EXCLUSIVAMENTE para
# ejecutar migraciones ('npm run db:migrate') o tareas de mantenimiento DDL.
# Debe apuntar al rol propietario ('app_user' o 'postgres'). NUNCA usar en runtime.
ADMIN_DATABASE_URL=postgresql://app_user:secreto_admin_cambiar@127.0.0.1:5432/app_db

# Parámetros para Docker Compose local (inicialización del contenedor de PostgreSQL)
DB_USER=app_user
DB_PASSWORD=secreto_admin_cambiar
DB_NAME=app_db

# ------------------------------------------------------------------------------
# AUTENTICACIÓN (SUPABASE AUTH)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase para verificación criptográfica de JWTs contra JWKS
SUPABASE_PROJECT_URL=https://tu-proyecto.supabase.co

# ------------------------------------------------------------------------------
# SEGURIDAD Y CORS
# ------------------------------------------------------------------------------
# Orígenes permitidos (separados por coma). NUNCA usar '*' en endpoints autenticados.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5173,https://tu-app.pages.dev

# Token secreto para endpoints de ingesta interna o webhooks
INGEST_SECRET=dev_ingest_secret_change_in_prod

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DE DOCUMENTOS
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=/app/data/documents

# ------------------------------------------------------------------------------
# PROVEEDOR LLM (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini (Google AI Studio / Vertex AI)
# Si está vacía, la API arranca con normalidad pero desactiva los extractores IA.
GEMINI_API_KEY=AIzaSy...tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_DOCUMENT_CHARS=250000
GEMINI_MAX_OUTPUT_TOKENS=8000
GEMINI_TIMEOUT_MS=45000
