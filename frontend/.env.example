# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — LICITAIA FRONTEND (Vite + React)
# ==============================================================================

# URL de la API Backend
# En desarrollo local: http://localhost:3000
# En producción (VPS + Caddy): https://api.pliegoai.com (o el dominio asignado a tu VPS)
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AUTENTICACIÓN (SUPABASE AUTH)
# ------------------------------------------------------------------------------
# Si estas dos variables se dejan vacías o comentadas, la aplicación se iniciará
# automáticamente en Modo Demo (sesiones en memoria, sin dependencia externa de nube).
#
# Al rellenarlas con las credenciales de tu proyecto Supabase:
# - Las sesiones se autentican criptográficamente contra el JWKS oficial.
# - Los tokens se mantienen 100% en memoria JavaScript (Regla 4.2 AGENTS.md anti-XSS).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_de_supabase
